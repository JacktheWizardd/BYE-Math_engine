{
  "spec": 0,
  "kind": "plot2d",
  "view": { "x": [0, 4], "y": [0, 9] },
  "grid": { "x": 1, "y": 2 },
  "axes": { "x": true, "y": true, "labels": false },
  "elements": [
    { "id": "f", "type": "function", "y": "2*x + 1", "role": "f", "label": { "text": "f", "at": 3.7 }, "animate": { "duration": 600 } },
    { "id": "area", "type": "region", "under": "f", "from": 1, "to": 3, "role": "area", "label": { "text": "area = 10", "at": "center" }, "animate": { "delay": 1000, "duration": 900 } },
    { "type": "segment", "from": [1, 0], "to": [1, "f(1)"], "role": "bound", "label": { "text": "a", "at": "below" }, "animate": { "delay": 600, "duration": 400 } },
    { "type": "segment", "from": [3, 0], "to": [3, "f(3)"], "role": "bound", "label": { "text": "b", "at": "below" }, "animate": { "delay": 600, "duration": 400 } },
    { "type": "text", "at": [1.25, 0.6], "text": "3 tall", "role": "note", "animate": { "delay": 1900, "duration": 300 } },
    { "type": "text", "at": [2.6, 0.6], "text": "7 tall", "role": "note", "animate": { "delay": 1900, "duration": 300 } }
  ],
  "describe": "Shaded area under f(x) = 2x + 1 from x = 1 to x = 3, equal to 10. The curve draws in, then the bounds, then the area fills from left to right."
}
