{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gallery-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "example",
        "run",
        "web",
        "--",
        "--port",
        "8081",
        "--clear"
      ],
      "port": 8081
    },
    {
      "name": "share-html",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path');const d=p.resolve('docs/share');h.createServer((q,r)=>{const n=decodeURIComponent(q.url.split('?')[0]);const fp=p.join(d,n==='/'?'bye-math-engine-3d.html':n);if(!fp.startsWith(d))return r.writeHead(403).end();f.readFile(fp,(e,b)=>{if(e)return r.writeHead(404).end();r.writeHead(200,{'Content-Type':fp.endsWith('.html')?'text/html; charset=utf-8':'application/octet-stream'}).end(b)})}).listen(process.env.PORT||8090)"
      ],
      "port": 8090
    }
  ]
}
